# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma client is generated by `postinstall: prisma generate` on every install
# and build, so it never needs to be committed. (This rule previously pointed at
# /src/generated/prisma, which is not where the client is emitted - so it never
# matched and the generated output was tracked by accident.)
/src/lib/generated/prisma

# Separate project that happens to live inside this directory
/peaktransport
